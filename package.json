{
  "name": "trend-arbitrage-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "radar:collect": "node --use-system-ca --import tsx src/lib/radar/cli.ts",
    "radar:export": "node --use-system-ca --import tsx src/lib/radar/cli.ts --export-only",
    "radar:status": "node scripts/radar-status.mjs",
    "radar:diagnose": "node --use-system-ca --import tsx scripts/diagnose-sources.ts",
    "radar:refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/radar-refresh.ps1",
    "dev:free": "next dev free --port 3101",
    "build:free": "next build free",
    "preview:free": "node scripts/preview-free.mjs",
    "test:browser": "playwright test",
    "verify:export": "node scripts/verify-export.mjs",
    "dev": "next dev free --port 3100",
    "build": "next build free",
    "start": "node scripts/preview-free.mjs",
    "dev:legacy": "next dev --port 3102",
    "build:legacy": "next build",
    "start:legacy": "next start --port 3102",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "ingest": "tsx src/lib/ingest/cli.ts",
    "scheduler": "tsx src/lib/scheduler.ts",
    "clean-demo": "tsx prisma/clean-demo.ts",
    "translate-db": "tsx prisma/translate-db.ts",
    "reset-data": "tsx prisma/reset-data.ts",
    "rescore": "tsx src/lib/scoring/rescore.ts",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.454.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
