# Trend Arbitrage Radar — environment
# Copy this file to `.env` and adjust values for your environment.

# ---- Database ----
# Local MVP uses SQLite (file-based, zero setup).
# For production PostgreSQL, change prisma/schema.prisma provider to "postgresql"
# and set a postgres connection string like:
# DATABASE_URL="postgresql://user:pass@localhost:5432/trendradar?schema=public"
DATABASE_URL="file:./dev.db"

# ---- Auth ----
# Secret used to sign session JWTs. Generate a long random string.
JWT_SECRET="change-me-to-a-long-random-secret-string-min-32-chars"
# Cookie lifetime in days
SESSION_DAYS="30"

# ---- AI Provider ----
# OpenRouter's free router selects a compatible free model for each request.
AI_PROVIDER="openrouter"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
# Alternative direct providers:
AGENTROUTER_API_KEY=""
AGENTROUTER_BASE_URL="https://agentrouter.org"
AGENTROUTER_MODEL="gpt-5.6-sol"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---- Live source providers (optional) ----
# Without these, the corresponding source falls back to the synthetic mock
# catalog so the app still has data. Hacker News & Reddit are live by default
# (no key). GitHub works unauthenticated (rate-limited); add a token for more.
GITHUB_TOKEN=""
# Product Hunt needs an OAuth bearer token from https://api.producthunt.com/v2/oauth/token
PRODUCT_HUNT_TOKEN=""
# Google Trends & X have no free API; they stay on mock until a proxy/paid
# backend is wired in.

# ---- Data mode & refresh ----
# DEMO_MODE=false → pure realtime: synthetic catalog is never merged in.
# Keep "true" for a zero-key first boot with demo data.
DEMO_MODE="true"
# Scheduler cadence for `npm run scheduler`.
INGEST_INTERVAL_HOURS="12"
# Archive ACTIVE opportunities unseen in live sources for this many days
# (saved ones are always protected).
PRUNE_AFTER_DAYS="7"

# ---- App ----
NEXT_PUBLIC_APP_NAME="Trend Arbitrage Radar"
NEXT_PUBLIC_DEMO_MODE="true"
