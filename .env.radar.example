# Copy values you need into .env.local. Never commit actual API keys.
# Existing .env is also read, but .env.local takes precedence.
RADAR_MODEL=openrouter/free
OPENROUTER_API_KEY=
RADAR_DAILY_AI_LIMIT=40
RADAR_AI_PER_RUN=5
# Optional. Higher authenticated GitHub source limits.
GITHUB_TOKEN=
# Leave disabled unless you have permission for the intended use.
RADAR_REDDIT_APPROVED=false
RADAR_PH_APPROVED=false
# For shepardai.pro/trends, build with /trends. For a subdomain, leave empty.
RADAR_BASE_PATH=
